// GENERATED by scripts/regmap_gen.py from scripts/{{ source }}.
// DO NOT EDIT -- edit the YAML and run `make regmap`.
//
// Names, offsets, widths, reset values and implemented-bit masks for the
// register file. The BEHAVIOUR that uses them is hand-written in
// rtl/axi4lite_reg_slave.sv, and deliberately so: W1C set-beats-clear,
// CTRL[1]'s self-clearing pulse, STATUS.error's transparency rule and
// COUNTER's reset-over-increment priority are each a paragraph of
// dut_spec.md section 5. See scripts/regmap_gen.py.
//
// A package rather than an include file: EDA Playground has no file
// list, so the design sources arrive as one concatenated paste and an
// `include of a .svh would land at the wrong scope. A package survives
// both a real file list and a concatenation.
//======================================================================

`timescale 1ns/1ps

// The package exports the WHOLE map. The RTL uses the indices, widths and
// resets; the RAL generator uses the offsets and masks; docs/register_map.md
// uses all of it. So from any one consumer's point of view most of these are
// unused, and that is correct rather than dead -- a register map that only
// exported what one file happened to need would not be a register map.
/* verilator lint_off UNUSEDPARAM */
package axi4lite_reg_pkg;

    localparam int ADDR_WIDTH_P = {{ block.addr_width }};
    localparam int DATA_WIDTH_P = {{ block.data_width }};

    //------------------------------------------------------------------
    // Decode, dut_spec.md section 5 as revised in v0.3.
    //
    // Implemented iff ADDR[{{ block.impl_msb }}:{{ block.impl_lsb }}] == 0 -- qualified on the FULL
    // offset and not on ADDR[7:2], because offset 0x100 must return
    // SLVERR rather than aliasing onto {{ regs[0].name }}.
    //------------------------------------------------------------------
    localparam int REG_COUNT     = {{ block.reg_count }};
    localparam int REG_IMPL_MSB  = {{ block.impl_msb }};
    localparam int REG_IMPL_LSB  = {{ block.impl_lsb }};
    localparam int REG_INDEX_MSB = {{ block.index_msb }};
    localparam int REG_INDEX_LSB = {{ block.index_lsb }};
    localparam int REG_INDEX_W   = {{ block.index_width }};

    //------------------------------------------------------------------
    // Register indices -- ADDR[{{ block.index_msb }}:{{ block.index_lsb }}]
    //------------------------------------------------------------------
{% for r in regs %}
    localparam logic [REG_INDEX_W-1:0] R_{{ "%-11s"|format(r.name) }} = {{ block.index_width }}'d{{ r.index }};   // 0x{{ "%02X"|format(r.offset) }}  {{ r.access }}
{% endfor %}

    //------------------------------------------------------------------
    // Per-register: byte offset, reset value, and the implemented-bit
    // mask. Reserved bits are the complement of the mask; dut_spec.md
    // section 5 requires them to read 0 and to be unable to store data
    // (feature F13), which is why the RTL stores each register at
    // implemented width only.
    //------------------------------------------------------------------
{% for r in regs %}
    localparam logic [DATA_WIDTH_P-1:0] {{ "%-18s"|format(r.name ~ "_OFFSET") }} = {{ block.data_width }}'h{{ "%08X"|format(r.offset) }};
    localparam logic [DATA_WIDTH_P-1:0] {{ "%-18s"|format(r.name ~ "_RESET") }} = {{ block.data_width }}'h{{ "%08X"|format(r.reset) }};
    localparam logic [DATA_WIDTH_P-1:0] {{ "%-18s"|format(r.name ~ "_MASK") }} = {{ block.data_width }}'h{{ "%08X"|format(r.mask) }};
    localparam int                      {{ "%-18s"|format(r.name ~ "_W") }} = {{ r.span }};
{% endfor %}

    //------------------------------------------------------------------
    // Per-field position, width and reset. The RTL declares its storage
    // from these, so narrowing a field in the YAML narrows the flop.
    //------------------------------------------------------------------
{% for r in regs %}
{% for f in r.fields %}
    localparam int {{ "%-28s"|format(r.name ~ "_" ~ f.name|upper ~ "_LSB") }} = {{ f.lsb }};
    localparam int {{ "%-28s"|format(r.name ~ "_" ~ f.name|upper ~ "_W") }} = {{ f.width }};
    localparam logic [DATA_WIDTH_P-1:0] {{ "%-13s"|format(r.name ~ "_" ~ f.name|upper ~ "_RESET") }} = {{ block.data_width }}'h{{ "%08X"|format(f.reset) }};   // {{ f.access }}
{% endfor %}
{% endfor %}

endpackage : axi4lite_reg_pkg
/* verilator lint_on UNUSEDPARAM */
